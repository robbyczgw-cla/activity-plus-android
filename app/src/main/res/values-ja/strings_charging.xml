<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 充電のアラート -->
    <string name="chg_limit_title">%1$s まで充電しました</string>
    <string name="chg_limit_body">電池を保護するため、今すぐ取り外せます。</string>
    <string name="chg_full_title">満充電</string>
    <string name="chg_full_body">電池が満充電になりました。電池を保護するため、今すぐ取り外せます。</string>
    <string name="chg_warm_title">充電中に高温: %1$s</string>
    <string name="chg_warm_body">電池が数分間温かい状態です。熱は電池を劣化させ、充電を遅くします。ケースを外すか、涼しい場所で充電してください。</string>

    <!-- 設定 -->
    <string name="chg_section">充電</string>
    <string name="chg_off">オフ</string>
    <string name="chg_set_limit">充電上限のアラート</string>
    <string name="chg_set_limit_hint">充電ごとに 1 回、電池がこの残量に達したことをお知らせします。早めに取り外せます。電池は満充電のまま維持しない方が劣化は遅くなります。</string>
    <string name="chg_set_full">満充電のアラート</string>
    <string name="chg_set_full_hint">充電ごとに 1 回、電池が満充電になったことをお知らせします。</string>
    <string name="chg_set_warm">充電中の高温</string>
    <string name="chg_set_warm_hint">接続中に電池が 2 分間 40 °C 以上になったときにお知らせします。通知は 1 時間に最大 1 回です。</string>
    <string name="chg_set_note">これらのアラートは「アラート」のスイッチに従います。</string>

    <!-- 充電器テスト -->
    <string name="chg_test_title">充電器テスト</string>
    <string name="chg_test_intro">この充電器とケーブルが電池へ供給する電力を、30 秒間計測します。この画面を開いたままにしてください。</string>
    <string name="chg_test_button">充電器をテスト</string>
    <string name="chg_test_running">計測中… %1$d / %2$d 秒</string>
    <string name="chg_test_stopped">端末の充電が止まったため、テストを終了しました。</string>
    <string name="chg_test_no_current">この端末は充電電流を報告しないため、計測できません。</string>
    <string name="chg_test_save_title">このテストを保存</string>
    <string name="chg_test_save_summary">平均 %1$s、ピーク %2$s</string>
    <string name="chg_test_name_label">名前（任意）</string>
    <string name="chg_test_name_hint">例: Anker 30 W + 短いケーブル</string>
    <string name="chg_test_save">保存</string>
    <string name="chg_test_discard">破棄</string>
    <string name="chg_test_past">過去のテスト（結果の良い順）</string>
    <string name="chg_test_unnamed">名前のないテスト</string>
    <string name="chg_test_peak">ピーク %1$s</string>
    <string name="chg_test_compare_note">結果は電池残量と温度によって変わります。満充電や高温の電池は取り込む電力が少なくなります。近い残量でテストを比べてください。</string>

    <!-- 健康度カードの容量の推移 -->
    <string name="chg_trend_title">満充電容量の推移</string>
    <string name="chg_trend_change">%2$s 以降 %1$s</string>
    <plurals name="chg_trend_count">
        <item quantity="other">%d 件の計測</item>
    </plurals>
    <string name="chg_trend_note" formatted="false">30 % 以上充電したすべての充電から推定しています。1 回だけでは大まかですが、推移には意味があります。</string>
</resources>
