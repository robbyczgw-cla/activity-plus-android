    <string name="f_storage_body">%1$s liberi su %2$s. Android rallenta e non può installare aggiornamenti quando lo spazio finisce.</string>
    <string name="f_memory_title">La memoria è scarsa</string>
    <string name="f_memory_body">Ne sono disponibili solo %1$s. Android chiude le app in background, quindi si ricaricano quando ci torni.</string>
    <string name="f_on_screen">%1$s è sullo schermo.</string>
    <string name="f_hot_title">Il telefono è caldo</string>
    <string name="f_hot_body">La batteria è al %1$s e Android riduce la velocità per raffreddarsi.</string>
    <string name="f_hot_app">%1$s è sullo schermo ed è probabilmente il carico.</string>
    <string name="f_saver_title">Il risparmio energetico è attivo</string>
    <string name="f_saver_body">Limita l\'attività in background e le prestazioni.</string>
    <string name="f_drain_title">%1$s ha consumato più batteria oggi</string>
    <string name="f_drain_body">%1$s in %2$s sullo schermo, %3$s della batteria usata con lo schermo acceso.</string>
    <string name="f_service_title">%1$s continua a funzionare in background</string>
    <string name="f_service_body">Oggi è stata in background per %1$s, anche se l\'hai aperta a malapena. Nelle info app puoi limitarne il consumo di batteria.</string>
    <string name="f_data_title">%1$s usa molti dati in background</string>
    <string name="f_data_body">Oggi %1$s in background. Nelle info app puoi disattivare i dati in background.</string>
    <string name="f_off_title">La batteria cala con lo schermo spento</string>
    <string name="f_off_body">%1$s all\'ora per %2$s con lo schermo spento. Qualcosa tiene sveglio il telefono; la pagina di utilizzo della batteria di Android mostra l\'attività in background per app.</string>
    <string name="f_worn_title">La batteria è usurata</string>
    <string name="f_worn_body">Mantiene circa il %1$s della sua capacità nominale. Una batteria usurata può far rallentare il telefono sotto carico.</string>
